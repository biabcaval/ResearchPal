# Local directory used by ChromaDB for its persistent index.
RESEARCHPAL_CHROMA_PATH=data/chroma
# Directory where the ingestion pipeline stores downloaded PDFs.
RESEARCHPAL_PDF_DIRECTORY=data/pdfs
# ChromaDB collection containing paper chunks.
RESEARCHPAL_COLLECTION=papers
# HTTP timeout, in seconds, for arXiv downloads.
RESEARCHPAL_REQUEST_TIMEOUT=30
# Streaming download buffer size, in bytes.
RESEARCHPAL_DOWNLOAD_CHUNK_SIZE=1048576
# Maximum number of tiktoken tokens in each indexed chunk.
RESEARCHPAL_CHUNK_SIZE=256
# Number of overlapping tokens between adjacent chunks.
RESEARCHPAL_CHUNK_OVERLAP=32
# Required Google AI Studio key. Keep this value only in .env.
GEMINI_API_KEY=
# Gemini model name available to the configured account.
GEMINI_MODEL=gemini-3.5-flash
# Maximum number of chunks returned by the search tool.
RESEARCHPAL_RETRIEVAL_LIMIT=5
# Optional minimum-distance filter; leave empty to disable it.
RESEARCHPAL_RETRIEVAL_SCORE_THRESHOLD=
# Base URL of the FastAPI process used by the Gradio UI.
RESEARCHPAL_API_URL=http://127.0.0.1:8000
# HTTP timeout, in seconds, for Gradio POSTs to /ask.
RESEARCHPAL_ASK_TIMEOUT=180
